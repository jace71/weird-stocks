---
import '../styles/global.css';

const { title = 'Weird Stocks!' } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.jpg" />
    <title>{title}</title>
  </head>
  <body class="bg-newsprint text-ink font-body">
    <slot />
  </body>
</html>
