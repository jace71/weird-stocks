---
const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;

const nav = [
  { href: '/', label: 'Home' },
  { href: '/stocks/', label: 'Weird Stocks' },
  { href: '/categories/', label: 'Categories' },
  { href: '/teachers/', label: 'Teachers' },
  { href: '/#newsletter', label: 'Newsletter' },
  { href: '/about/', label: 'About' },
];

function isCurrent(href: string) {
  if (href.includes('#')) return false;
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href);
}

const onTeachers = isCurrent('/teachers/');
---

<footer class="border-t-4 border-ink bg-ink text-newsprint">
  <div class="mx-auto grid max-w-7xl gap-8 px-6 py-10 md:grid-cols-2 md:items-center">
    <nav aria-label="Footer navigation">
      <ul class="flex flex-wrap gap-x-5 gap-y-3 text-sm font-extrabold uppercase tracking-wide">
        {
          nav.map((item) => {
            const current = isCurrent(item.href);
            return (
              <li>
                <a
                  class:list={[
                    'transition-colors hover:text-tabloid-yellow focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-tabloid-yellow',
                    current && 'text-tabloid-yellow underline decoration-2 underline-offset-4',
                  ]}
                  href={item.href}
                  aria-current={current ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <p class="text-sm leading-relaxed text-newsprint/75 md:text-right">
      {
        onTeachers
          ? 'Weird Stocks is for entertainment and educational purposes only and is not investment advice. Do your own research before making financial decisions.'
          : 'Weird Stocks is for entertainment purposes only and is not investment advice. Do your own research before making financial decisions.'
      }
    </p>
  </div>
</footer>
