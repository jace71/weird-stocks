---
interface Props {
  ticker: string;
  headline: string;
  weirdFactor: number;
  href: string;
  category?: string;
  company?: string;
  heading?: 'h2' | 'h3';
  stretch?: boolean;
  publishTime?: number;
}

const {
  ticker,
  headline,
  weirdFactor,
  href,
  category,
  company,
  heading = 'h2',
  stretch = false,
  publishTime,
} = Astro.props;

const HeadingTag = heading === 'h3' ? 'h3' : 'h2';
const sortable = publishTime !== undefined;
---

<a
  class:list={[
    'block transition-transform hover:-translate-y-1 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-tabloid-red',
    stretch && 'h-full',
  ]}
  href={href}
  data-stock-card={sortable ? 'true' : undefined}
  data-ticker={sortable ? ticker : undefined}
  data-weird={sortable ? weirdFactor : undefined}
  data-publish={sortable ? publishTime : undefined}
>
  <article class:list={['border-2 border-ink bg-paper p-5 shadow-tabloid', stretch && 'h-full']}>
    <div class="mb-4 flex items-start justify-between gap-4">
      {
        category ? (
          <div class="min-w-0">
            <span class="font-mono text-sm font-bold uppercase tracking-wider text-ink/70">{ticker}</span>
            <p class="mt-1 font-mono text-xs font-bold uppercase tracking-widest text-tabloid-red">{category}</p>
          </div>
        ) : (
          <span class="font-mono text-sm font-bold uppercase tracking-wider text-ink/70">{ticker}</span>
        )
      }
      <span
        class:list={[
          '-rotate-2 border-2 border-ink bg-tabloid-pink px-3 py-1 font-headline text-sm uppercase text-ink shadow-tabloid',
          category && 'shrink-0',
        ]}
      >
        Weird Factor: {weirdFactor}/10
      </span>
    </div>
    {company && <p class="mb-2 font-extrabold uppercase tracking-wide">{company}</p>}
    <HeadingTag class="font-headline text-2xl uppercase leading-tight">{headline}</HeadingTag>
  </article>
</a>
