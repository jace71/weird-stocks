---
interface Props {
  ticker: string;
  headline: string;
  weirdFactor: number;
}

const { ticker, headline, weirdFactor } = Astro.props;
---

<article class="border-2 border-ink bg-paper p-5 shadow-tabloid">
  <div class="mb-4 flex items-start justify-between gap-4">
    <span class="font-mono text-sm font-bold uppercase tracking-wider text-ink/70">{ticker}</span>
    <span class="-rotate-2 border-2 border-ink bg-tabloid-pink px-3 py-1 font-headline text-sm uppercase text-ink shadow-tabloid">
      Weird Factor: {weirdFactor}/10
    </span>
  </div>
  <h2 class="font-headline text-2xl uppercase leading-tight">{headline}</h2>
</article>
