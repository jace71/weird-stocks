---
interface Props {
  text?: string;
}

const { text = 'Shocking!' } = Astro.props;
---

<span class="starburst" aria-label={text}>
  <svg class="starburst-shape" viewBox="0 0 100 100" aria-hidden="true">
    <polygon
      points="50,2 59,20 75,8 76,28 97,25 87,44 99,54 80,63 91,82 70,79 63,98 48,83 33,98 28,78 8,86 15,66 1,54 19,43 7,26 29,28 34,7 47,20"
    />
  </svg>
  <span class="starburst-text">{text}</span>
</span>

<style>
  .starburst {
    position: relative;
    display: inline-grid;
    width: 9rem;
    aspect-ratio: 1;
    place-items: center;
    color: var(--color-ink);
    vertical-align: middle;
  }

  .starburst-shape {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    filter: drop-shadow(5px 5px 0 var(--color-ink));
  }

  .starburst-shape polygon {
    fill: var(--color-tabloid-yellow);
    stroke: var(--color-ink);
    stroke-width: 2.5;
    stroke-linejoin: round;
  }

  .starburst-text {
    position: relative;
    max-width: 70%;
    font-family: var(--font-headline);
    font-size: 1.25rem;
    line-height: 1;
    text-align: center;
    text-transform: uppercase;
    overflow-wrap: anywhere;
    transform: rotate(-8deg);
  }
</style>
