---
const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;

const nav = [
  { href: '/', label: 'Home' },
  { href: '/stocks/', label: 'Weird Stocks' },
  { href: '/categories/', label: 'Categories' },
  { href: '/teachers/', label: 'Teachers' },
  { href: '/#newsletter', label: 'Newsletter' },
  { href: '/about/', label: 'About' },
];

function isCurrent(href: string) {
  if (href.includes('#')) return false;
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href);
}

const onTeachers = isCurrent('/teachers/');
---

<header class="border-b-4 border-ink bg-newsprint">
  <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-5 px-6 py-5">
    <a href="/" class="flex items-center gap-3" aria-label="Weird Stocks home">
      <span class="grid size-11 -rotate-3 place-items-center bg-tabloid-red font-headline text-2xl text-paper shadow-tabloid">
        WS!
      </span>
      <span class="font-headline text-2xl uppercase leading-none tracking-wide">Weird Stocks</span>
    </a>

    <nav aria-label="Main navigation">
      <ul class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm font-extrabold uppercase tracking-wide">
        {
          nav.map((item) => {
            const current = isCurrent(item.href);
            return (
              <li>
                <a
                  class:list={[
                    'transition-colors hover:text-tabloid-red focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-tabloid-red',
                    current && 'text-tabloid-red underline decoration-2 underline-offset-4',
                  ]}
                  href={item.href}
                  aria-current={current ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <a
      class="inline-block border-2 border-ink bg-tabloid-yellow px-5 py-2 font-extrabold uppercase shadow-tabloid transition-transform hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-tabloid-red"
      href={onTeachers ? '#signup' : '/#newsletter'}
    >
      {onTeachers ? 'Get lessons' : 'Subscribe'}
    </a>
  </div>
</header>
