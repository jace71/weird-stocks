---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Starburst from '../components/Starburst.astro';
import StockCard from '../components/StockCard.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { defaultDescription, websiteJsonLd } from '../lib/site';

const stocks = await getCollection('stocks');
const featuredStocks = stocks.filter(({ data }) => data.featured);
const stockOfTheWeek = featuredStocks.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
)[0];
const recentStocks = [...stocks]
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 6);
---

<Layout
  title={stockOfTheWeek ? `${stockOfTheWeek.data.company} | Weird Stocks` : 'Weird Stocks'}
  description={defaultDescription}
  jsonLd={websiteJsonLd()}
>
  <main class="mx-auto max-w-7xl px-6 pb-12 pt-7 md:pb-20 md:pt-10">
    <p class="mb-7 block w-fit max-w-full whitespace-nowrap border-2 border-ink bg-tabloid-yellow py-[0.4rem] pl-[0.6rem] pr-[0.7rem] font-headline text-[1.0625rem] uppercase leading-none tracking-tight text-ink shadow-tabloid md:mb-10 md:px-[0.85rem] md:py-[0.45rem] md:text-[1.75rem]">
      Learning economics one weird stock at a time.
    </p>
    <div class="grid gap-12 lg:grid-cols-3 lg:items-start lg:gap-8">
      {stockOfTheWeek && (
        <section
          class="relative min-w-0 border-4 border-ink bg-paper p-6 shadow-tabloid-lg md:p-12 lg:col-span-2"
          aria-labelledby="stock-of-the-week"
        >
          <div class="mb-8 flex flex-wrap items-center gap-4 lg:pr-36">
            <p
              id="stock-of-the-week"
              class="inline-block -rotate-2 bg-tabloid-red px-4 py-2 font-headline text-2xl uppercase text-paper shadow-tabloid"
            >
              Stock of the Week
            </p>
            <span class="min-w-0 basis-full pr-40 font-mono text-sm font-bold uppercase tracking-widest md:basis-auto md:pr-0">
              {stockOfTheWeek.data.ticker} / {stockOfTheWeek.data.category}
            </span>
          </div>

          <div class="absolute right-5 top-5 md:right-10 md:top-8">
            <Starburst text="Shocking!" />
          </div>

          <p class="mb-3 pr-28 font-extrabold uppercase tracking-wide text-tabloid-red sm:pr-36">
            {stockOfTheWeek.data.kicker}
          </p>
          <h1 class="max-w-5xl pr-4 font-headline text-[1.8rem] uppercase leading-[0.95] tracking-tight sm:pr-12 md:pr-16 md:text-[2.7rem] lg:pr-8 lg:text-[3.6rem]">
            {stockOfTheWeek.data.headline}
          </h1>
          <p class="mt-8 max-w-3xl text-lg leading-relaxed text-ink/80 md:text-xl">
            {stockOfTheWeek.data.summary}
          </p>
          <div class="mt-8 flex flex-wrap gap-x-8 gap-y-3 border-t-2 border-ink pt-5 font-mono text-sm font-bold uppercase">
            <p>Company: {stockOfTheWeek.data.company}</p>
            <p>Weird Factor: {stockOfTheWeek.data.weirdFactor}/10</p>
          </div>
          <a
            class="mt-8 inline-block border-2 border-ink bg-tabloid-yellow px-5 py-3 font-extrabold uppercase shadow-tabloid transition-transform hover:-translate-y-0.5"
            href={`/stocks/${stockOfTheWeek.id}/`}
          >
            Read the full profile
          </a>
        </section>
      )}

      <div class="min-w-0 lg:sticky lg:top-6">
        <NewsletterSignup />
      </div>
    </div>

    <section class="mt-16" aria-labelledby="recent-weird-stocks">
      <h2
        id="recent-weird-stocks"
        class="mb-8 inline-block -rotate-1 bg-tabloid-yellow px-4 py-2 font-headline text-4xl uppercase shadow-tabloid md:text-5xl"
      >
        Recent Weird Stocks
      </h2>
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        {recentStocks.map((stock) => (
          <StockCard
            ticker={stock.data.ticker}
            headline={stock.data.headline}
            weirdFactor={stock.data.weirdFactor}
            href={`/stocks/${stock.id}/`}
          />
        ))}
      </div>
    </section>
  </main>
</Layout>
