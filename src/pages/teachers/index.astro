---
import { existsSync } from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';
import TeacherLessonCard from '../../components/TeacherLessonCard.astro';
import Layout from '../../layouts/Layout.astro';
import {
  lessonConcepts,
  teachersPageDescription,
  teacherLessons,
  tickerGame,
} from '../../data/teacher-lessons';
import { kitFormAction } from '../../lib/newsletter';
import { teachersPageJsonLd } from '../../lib/site';

const stockIds = new Set((await getCollection('stocks')).map((stock) => stock.id));

for (const lesson of teacherLessons) {
  if (!stockIds.has(lesson.slug)) {
    throw new Error(
      `Teacher lesson ${lesson.ticker} must link to a real lowercase stock slug. /stocks/${lesson.slug}/ is not a profile.`,
    );
  }
  for (const file of [
    { href: lesson.pdfHref, label: 'PDF' },
    { href: lesson.slidesPdfHref, label: 'slides PDF' },
  ]) {
    if (!file.href) continue;
    const relative = file.href.replace(/^\//, '');
    if (!existsSync(path.join(process.cwd(), 'public', relative))) {
      throw new Error(`Teacher lesson ${lesson.ticker} ${file.label} is missing at public/${relative}.`);
    }
  }
}

const readyLessons = teacherLessons.filter((lesson) => lesson.ready);
const lessonNoun = teacherLessons.length === 1 ? 'lesson' : 'lessons';

// The role menu and 18+ checkbox are required in the browser and have no
// name, so they are not posted. Kit's form only accepts email_address.
// TODO(jason): store those answers as Kit custom fields if you want them,
// and point this form at a teacher-only Kit form if it should not join the
// weekly list. Downloads stay open until a real gate exists.

const steps = [
  {
    title: 'Pick a concept',
    body: "Filter the cards by the idea you're teaching: royalties, land, conglomerates, brands.",
  },
  {
    title: 'Open with the game',
    body: 'Five minutes of ticker guessing gets the room talking before the lesson.',
  },
  {
    title: 'Print or project',
    body: 'Each card is one page as a PDF. When a deck is posted, copy it into your own Google Slides or download the slides as a PDF.',
  },
  {
    title: 'Discuss, then do',
    body: 'Use the questions, run the 10-minute activity, and send students to the full profile.',
  },
];

const cardIncludes = [
  'A ticker hook and a short true story',
  '3–4 key terms in plain language',
  'Discussion questions',
  'A 10-minute activity',
  'Sources and a standards connection',
];

const faqs = [
  {
    question: 'Is this free?',
    answer:
      'Yes. Every lesson card, slide deck and game is free. Four lesson PDFs are ready to download: Mesabi Trust, Texas Pacific Land, Seaboard, and National Beverage. The Mesabi Trust deck is available as your own Google Slides copy and as a PDF. The email signup sends the monthly lesson to adults. You do not need to sign up to download a lesson that is already posted, and the signup does not collect student information.',
    open: true,
  },
  {
    question: 'Is it investment advice?',
    answer:
      'No. These lessons teach how businesses and money work, using real companies as examples. Nothing here is a recommendation to buy or sell any security, and the portfolio activities use pretend money.',
  },
  {
    question: 'What grades?',
    answer:
      'The cards are written for high school, grades 9–12. Each one says what concept it covers so you can fit it into personal finance, economics or business classes.',
  },
];
---

<Layout
  title="Weird Stocks for the Classroom | Weird Stocks"
  description={teachersPageDescription}
  jsonLd={teachersPageJsonLd({
    description: teachersPageDescription,
    lessons: readyLessons.map((lesson) => ({
      name: `${lesson.title} (${lesson.ticker})`,
      description: lesson.hook,
      url: lesson.pdfHref ?? `/stocks/${lesson.slug}/`,
    })),
  })}
>
  <main class="mx-auto max-w-7xl px-6 py-12 md:py-20">
    <div class="grid items-center gap-8 lg:grid-cols-5">
      <div class="lg:col-span-3">
        <p class="mb-5 inline-block -rotate-1 bg-tabloid-yellow px-3.5 py-1.5 font-headline text-[1.375rem] uppercase shadow-tabloid">
          For teachers · Free
        </p>
        <h1 class="font-headline text-5xl uppercase leading-[0.95] tracking-tight md:text-7xl">
          Weird Stocks for the Classroom
        </h1>
        <p class="mt-4 max-w-xl text-xl leading-relaxed text-ink/85">
          {teachersPageDescription}
        </p>
        <div class="mt-6 flex flex-wrap gap-4">
          <a
            class="inline-block border-2 border-ink bg-tabloid-yellow px-5 py-3 text-sm font-extrabold uppercase tracking-wide shadow-tabloid transition-transform hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-tabloid-red"
            href="#lessons"
          >
            Browse lessons
          </a>
          <a
            class="inline-block border-2 border-ink bg-paper px-5 py-3 text-sm font-extrabold uppercase tracking-wide shadow-tabloid transition-transform hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-tabloid-red"
            href="#signup"
          >
            Get the monthly lesson
          </a>
        </div>
        <p class="mt-5 inline-flex flex-wrap items-center gap-2.5 border-2 border-dashed border-ink bg-paper px-3.5 py-2 font-mono text-[13px] font-bold uppercase tracking-wide">
          <b class="bg-ink px-2 py-0.5 text-tabloid-yellow">No ads</b>
          This page and every download are ad-free.
        </p>
      </div>
      <aside
        class="relative mt-4 border-4 border-ink bg-paper p-6 shadow-tabloid-lg rotate-1 lg:col-span-2 lg:mt-0"
        aria-label="What's in each lesson card"
      >
        <span class="absolute -top-4 right-4 rotate-3 border-2 border-ink bg-tabloid-red px-3 py-1 font-headline text-lg uppercase text-paper">
          Every card
        </span>
        <p class="font-mono text-xs font-bold uppercase tracking-widest">One printable page · Grades 9–12</p>
        <ul class="mt-2 list-disc space-y-1 pl-5 text-base leading-relaxed marker:text-tabloid-red">
          {cardIncludes.map((item) => <li>{item}</li>)}
        </ul>
      </aside>
    </div>

    <section class="mt-16 md:mt-20" aria-labelledby="how-title">
      <h2
        id="how-title"
        class="mb-6 inline-block -rotate-1 bg-tabloid-yellow px-3.5 py-1.5 font-headline text-4xl uppercase leading-tight shadow-tabloid md:text-5xl"
      >
        How to use these
      </h2>
      <div class="grid border-4 border-ink bg-ink shadow-tabloid md:grid-cols-4">
        {
          steps.map((step, index) => (
            <div class="border-b-2 border-ink bg-paper p-5 last:border-b-0 md:border-r-2 md:border-b-0 md:last:border-r-0">
              <span class="mb-2.5 grid size-9 place-items-center bg-tabloid-red font-headline text-xl text-paper">
                {index + 1}
              </span>
              <h3 class="font-headline text-xl uppercase leading-tight">{step.title}</h3>
              <p class="mt-1.5 text-[15px] leading-normal text-ink/80">{step.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-16 scroll-mt-6 md:mt-20" id="lessons" aria-labelledby="lessons-title">
      <h2
        id="lessons-title"
        class="mb-6 inline-block -rotate-1 bg-tabloid-yellow px-3.5 py-1.5 font-headline text-4xl uppercase leading-tight shadow-tabloid md:text-5xl"
      >
        Lesson cards
      </h2>
      <div
        class="mb-3 flex flex-wrap items-center gap-3 border-4 border-ink bg-paper p-4 shadow-tabloid"
        role="group"
        aria-label="Filter and sort lessons"
      >
        <span class="font-mono text-[13px] font-bold uppercase tracking-widest">Concept</span>
        <button
          type="button"
          class="cursor-pointer border-2 border-ink bg-paper px-3 py-2 text-xs font-extrabold uppercase tracking-wide shadow-tabloid focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-tabloid-red aria-pressed:bg-tabloid-red aria-pressed:text-paper"
          data-lesson-filter="all"
          aria-pressed="true"
        >
          All
        </button>
        {
          lessonConcepts.map((concept) => (
            <button
              type="button"
              class="cursor-pointer border-2 border-ink bg-paper px-3 py-2 text-xs font-extrabold uppercase tracking-wide shadow-tabloid focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-tabloid-red aria-pressed:bg-tabloid-red aria-pressed:text-paper"
              data-lesson-filter={concept.id}
              aria-pressed="false"
            >
              {concept.label}
            </button>
          ))
        }
        <span class="h-0 basis-full lg:h-7 lg:w-0.5 lg:basis-auto lg:bg-ink" aria-hidden="true"></span>
        <label class="font-mono text-[13px] font-bold uppercase tracking-widest" for="lesson-sort">Sort</label>
        <select
          id="lesson-sort"
          class="border-2 border-ink bg-tabloid-yellow px-2.5 py-2 text-xs font-extrabold uppercase focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-tabloid-red"
        >
          <option value="ready">Ready first</option>
          <option value="concept">Concept A–Z</option>
          <option value="ticker">Ticker A–Z</option>
        </select>
      </div>
      <p class="mb-8 text-[15px] leading-normal text-ink/75" id="lesson-caption" aria-live="polite">
        Showing all {teacherLessons.length} {lessonNoun}. Ready-to-use lessons first.
      </p>
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2" id="lesson-grid">
        {teacherLessons.map((lesson) => <TeacherLessonCard lesson={lesson} />)}
      </div>
    </section>

    <section class="mt-16 md:mt-20" aria-labelledby="games-title">
      <h2
        id="games-title"
        class="mb-6 inline-block -rotate-1 bg-tabloid-yellow px-3.5 py-1.5 font-headline text-4xl uppercase leading-tight shadow-tabloid md:text-5xl"
      >
        Classroom games
      </h2>
      <div class="grid gap-8 border-4 border-ink bg-tabloid-red p-6 text-paper shadow-tabloid-lg lg:grid-cols-3 lg:p-9">
        <div>
          <p class="font-mono text-xs font-bold uppercase tracking-widest text-tabloid-yellow">
            Opener · 5 minutes · No prep
          </p>
          <h3 class="mt-3 font-headline text-4xl uppercase leading-none">Guess the ticker</h3>
          <p class="mt-3 leading-relaxed">
            Show a ticker symbol. Students shout out which company they think it is and why. Then flip the card. It's a fast way to show that a stock is a piece of a real business.
          </p>
          <p class="mt-4">
            <a
              class="inline-block border-2 border-ink bg-tabloid-yellow px-5 py-3 text-sm font-extrabold uppercase tracking-wide text-ink shadow-tabloid transition-transform hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-paper"
              href="#signup"
            >
              Get the printable version
            </a>
          </p>
        </div>
        <div class="grid grid-cols-2 gap-4 md:grid-cols-4 lg:col-span-2">
          {
            tickerGame.map((prompt) => (
              <details class="border-2 border-ink bg-paper p-4 text-center text-ink shadow-tabloid" open={prompt.open}>
                <summary class="cursor-pointer list-none marker:content-none [&::-webkit-details-marker]:hidden">
                  <span class="block font-headline text-[2.5rem] leading-none">{prompt.ticker}</span>
                  <span class="mt-1.5 block font-mono text-[11px] font-bold uppercase tracking-wide text-ink/60">
                    Tap to reveal
                  </span>
                </summary>
                <p class="mt-2.5 border-t-2 border-ink pt-2.5 text-sm font-extrabold leading-snug">
                  {prompt.company}
                  <span class="mt-1 block text-xs font-normal text-ink/70">{prompt.detail}</span>
                </p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="mt-16 scroll-mt-6 md:mt-20" id="signup" aria-labelledby="signup-title">
      <div class="grid gap-7 border-4 border-ink bg-ink p-6 text-newsprint shadow-tabloid-lg lg:grid-cols-2 lg:items-center lg:p-10">
        <div>
          <p class="font-mono text-xs font-bold uppercase tracking-widest text-tabloid-yellow">
            Monthly teacher lesson · Free
          </p>
          <h2 id="signup-title" class="mt-2 font-headline text-4xl uppercase leading-none md:text-5xl">
            Get one new lesson a month
          </h2>
          <p class="mt-3 leading-relaxed text-newsprint/85">
            A new lesson card and a classroom game in your inbox each month. Four lesson PDFs are free to download now: Mesabi Trust, Texas Pacific Land, Seaboard, and National Beverage. The Mesabi Trust deck is ready as a Google Slides copy and a PDF.
          </p>
          <p class="mt-3 text-[13px] leading-relaxed text-newsprint/65">
            For teachers and other adults only. We don't collect student information. Unsubscribe anytime.
          </p>
        </div>
        <form action={kitFormAction} method="post" class="grid gap-3">
          <label class="font-mono text-xs font-bold uppercase tracking-widest" for="teacher-email">
            School or personal email
          </label>
          <input
            id="teacher-email"
            class="w-full border-2 border-ink bg-paper px-3.5 py-3 text-base text-ink placeholder:text-ink/50 focus:outline-2 focus:outline-offset-2 focus:outline-tabloid-yellow"
            type="email"
            name="email_address"
            autocomplete="email"
            required
            placeholder="you@school.org"
          />
          <label class="font-mono text-xs font-bold uppercase tracking-widest" for="teacher-role">I teach</label>
          <select
            id="teacher-role"
            class="w-full border-2 border-ink bg-paper px-3.5 py-3 text-base text-ink focus:outline-2 focus:outline-offset-2 focus:outline-tabloid-yellow"
            required
          >
            <option>High school personal finance</option>
            <option>High school economics</option>
            <option>Business / CTE</option>
            <option>Something else</option>
          </select>
          <label class="flex items-start gap-2.5 text-sm leading-snug font-normal normal-case tracking-normal">
            <input class="mt-1" type="checkbox" required />
            I'm an educator or adult, 18 or older.
          </label>
          <button
            class="cursor-pointer border-2 border-paper bg-tabloid-yellow px-3.5 py-3.5 text-[15px] font-extrabold uppercase text-ink shadow-[6px_6px_0_0_var(--color-tabloid-red)] transition-transform hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-paper"
            type="submit"
          >
            Get the monthly lesson
          </button>
        </form>
      </div>
    </section>

    <section class="mt-16 md:mt-20" aria-labelledby="faq-title">
      <h2
        id="faq-title"
        class="mb-6 inline-block -rotate-1 bg-tabloid-yellow px-3.5 py-1.5 font-headline text-4xl uppercase leading-tight shadow-tabloid md:text-5xl"
      >
        FAQ
      </h2>
      <div class="grid max-w-3xl gap-4">
        {
          faqs.map((item) => (
            <details class="border-2 border-ink bg-paper shadow-tabloid" open={item.open}>
              <summary class="cursor-pointer px-5 py-4 font-headline text-[1.35rem] uppercase leading-tight focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-tabloid-red">
                {item.question}
              </summary>
              <p class="px-5 pb-4 leading-relaxed text-ink/85">{item.answer}</p>
            </details>
          ))
        }
      </div>
    </section>

    <div class="mt-14 flex flex-wrap items-center gap-x-5 gap-y-3 border-4 border-ink bg-tabloid-yellow px-5 py-4 shadow-tabloid" role="note">
      <strong class="font-headline text-3xl uppercase">No ads here.</strong>
      <span class="max-w-3xl leading-relaxed">
        The teachers page and every download carry no ads. Any sponsor of the teacher newsletter is clearly labeled and never pays for coverage of a stock.
      </span>
    </div>

    <aside
      class="mt-8 border-2 border-ink bg-newsprint p-4 text-sm leading-relaxed shadow-tabloid"
      aria-label="Investment disclaimer"
    >
      <p>
        <strong class="font-extrabold uppercase">Disclaimer:</strong>
        Weird Stocks is for entertainment and educational purposes only and is not investment advice.
        These lessons are not a recommendation to buy or sell any security.
        Do your own research before making financial decisions.
      </p>
    </aside>
  </main>
</Layout>

<script>
  const grid = document.querySelector<HTMLElement>('#lesson-grid');
  const caption = document.querySelector<HTMLElement>('#lesson-caption');
  const sortSelect = document.querySelector<HTMLSelectElement>('#lesson-sort');
  const filterButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-lesson-filter]')];

  if (grid && caption && sortSelect && filterButtons.length > 0) {
    let filter = 'all';
    const sortText: Record<string, string> = {
      ready: 'Ready-to-use lessons first.',
      concept: 'Sorted by concept, A to Z.',
      ticker: 'Sorted by ticker, A to Z.',
    };

    const render = () => {
      const cards = [...grid.querySelectorAll<HTMLElement>('[data-lesson]')];
      const mode = sortSelect.value;
      cards.sort((a, b) => {
        if (mode === 'ready') {
          const readyDiff = Number(b.dataset.ready) - Number(a.dataset.ready);
          if (readyDiff !== 0) return readyDiff;
          return Number(a.dataset.order) - Number(b.dataset.order);
        }
        if (mode === 'concept') {
          const conceptDiff = (a.dataset.conceptName ?? '').localeCompare(b.dataset.conceptName ?? '', 'en');
          if (conceptDiff !== 0) return conceptDiff;
        }
        return (a.dataset.ticker ?? '').localeCompare(b.dataset.ticker ?? '', 'en');
      });

      let shown = 0;
      for (const card of cards) {
        const show = filter === 'all' || card.dataset.concept === filter;
        card.toggleAttribute('hidden', !show);
        if (show) shown += 1;
        grid.append(card);
      }

      const total = cards.length;
      const range = shown === total ? `all ${total}` : `${shown} of ${total}`;
      const noun = total === 1 ? 'lesson' : 'lessons';
      const suffix = sortText[mode] ?? '';
      caption.textContent = `Showing ${range} ${noun}. ${suffix}`.trim();
    };

    for (const button of filterButtons) {
      button.addEventListener('click', () => {
        filter = button.dataset.lessonFilter ?? 'all';
        for (const other of filterButtons) {
          other.setAttribute('aria-pressed', other === button ? 'true' : 'false');
        }
        render();
      });
    }

    sortSelect.addEventListener('change', render);
    render();
  }
</script>
