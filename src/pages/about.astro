---
import Base from '../layouts/Base.astro';
---

<Base title="About | Weird Stocks">
  <main class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="font-headline text-5xl uppercase tracking-tight text-ink">About</h1>
    <p class="mt-6 text-lg leading-relaxed text-ink/80">
      Weird Stocks is a playful little archive of the oddest, funniest, and most unexpectedly fascinating tickers out there.
    </p>
    <p class="mt-4 text-lg leading-relaxed text-ink/80">
      The goal is simple: celebrate the weird side of the market, one unusual company at a time.
    </p>
  </main>
</Base>
