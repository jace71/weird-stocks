# Copy this file to `.env` (in the project root, next to package.json) and paste your key.
# `.env` must NEVER be committed. Make sure `.env` is listed in .gitignore.
# Get a key at https://marketstack.com/signup (the free plan is fine for local testing).
#
# NOTE: no PUBLIC_ prefix on purpose. That keeps the key out of browser code.
MARKETSTACK_API_KEY=paste-your-key-here
